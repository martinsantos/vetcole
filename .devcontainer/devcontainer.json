{
  "name": "ColVet Digital (demo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm run setup && npm run build",
  "postStartCommand": "nohup npm start > /tmp/colvet.log 2>&1 &",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "ColVet Digital", "onAutoForward": "openBrowser" }
  },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
